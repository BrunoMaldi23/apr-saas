# Copiar a .env.deploy en la VM. Nunca subir este archivo con valores reales.

# Password del superuser de Postgres dentro del container (no se expone al host).
POSTGRES_PASSWORD="cambia-este-password-postgres"

# Rol usado solo por Prisma CLI (migraciones y seed).
ADMIN_DB_PASSWORD="cambia-este-password-apr-admin"

# Rol usado por la API en runtime. No es owner; RLS se aplica.
APP_DB_PASSWORD="cambia-este-password-apr-app"

# Secreto JWT de la API.
JWT_SECRET="cambia-este-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

# Orígenes reales de los frontends desplegados en Vercel (sin barra final).
WEB_ADMIN_URL="https://admin-xxx.vercel.app"
PWA_URL="https://pwa-xxx.vercel.app"

# Token del túnel creado en Cloudflare Zero Trust.
CLOUDFLARE_TUNNEL_TOKEN="pegar-token-del-tunnel"
