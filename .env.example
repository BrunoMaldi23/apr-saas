# Conexión usada por Prisma CLI (migraciones y seed). Owner de las tablas.
DATABASE_URL="postgresql://apr_admin:Admin1234!@localhost:5433/apr_saas?schema=public"

# Conexión usada por la API en runtime. No es owner => RLS se aplica.
APP_DATABASE_URL="postgresql://apr_app:App1234!@localhost:5433/apr_saas?schema=public"

JWT_SECRET="cambia-este-secreto-en-produccion-apr-saas-2026"
JWT_EXPIRES_IN="8h"
PORT=3000
WEB_ADMIN_URL="http://localhost:5173"
PWA_URL="http://localhost:5174"
